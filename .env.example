# ============================================================
# Configuración del Chatbot - Facultad de Ingeniería
# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas tu ".env" real (con la clave) a un repositorio.
# ============================================================

# --- Groq (LLM en la nube, nivel gratuito) ---
# Obtén tu clave gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Modelo usado para generar respuestas.
# openai/gpt-oss-20b: muy rápido (~1000 tok/s), gratuito, 131K contexto (recomendado).
# Alternativa: openai/gpt-oss-120b (más preciso, algo más lento).
# NOTA: el catálogo de modelos de Groq cambia con el tiempo (ya retiraron los
# modelos Llama que estaban documentados). Verifica los modelos vigentes para
# tu cuenta en https://console.groq.com/docs/models antes de cambiar esto.
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings (locales, gratuitos, sin depender de Groq) ---
# Modelo multilingüe de Sentence Transformers (bueno para español).
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- RAG / Recuperación ---
# Cantidad de fragmentos (chunks) que se recuperan por consulta
TOP_K=4
# Tamaño de cada chunk de texto (en caracteres)
CHUNK_SIZE=1000
# Superposición entre chunks consecutivos (en caracteres)
CHUNK_OVERLAP=150
# Umbral mínimo de similitud (0 a 1) para considerar un fragmento relevante.
# Si nada supera este umbral, el chatbot responde que no tiene información suficiente
# sin siquiera llamar al LLM.
SIMILARITY_THRESHOLD=0.35
# Umbral más bajo, solo para decidir si vale la pena sugerirle al estudiante
# preguntas alternativas cuando su mensaje fue muy corto/ambiguo y no se
# encontró información suficiente (ver sección de sugerencias en el README).
SUGGESTION_MIN_SIMILARITY=0.15

# --- Historial de conversación ---
# Número máximo de intercambios previos (pregunta+respuesta) que se envían como contexto
MAX_HISTORY_TURNS=3

# Respaldo periódico de history.db (todas las conversaciones), para no
# perderlo todo si el archivo se corrompe o se borra por error.
HISTORY_BACKUP_DIR=backups
# Cada cuánto respaldar, en segundos (por defecto cada 6 horas).
HISTORY_BACKUP_INTERVAL_SECONDS=21600
# Cuántos respaldos conservar (los más viejos se van eliminando).
HISTORY_BACKUP_RETENTION=14

# --- Panel de administración: SLA de auto-escalación ---
# Si una dependencia no responde una conversación asignada dentro de este
# tiempo, se redirige automáticamente al administrador general.
AUTO_ESCALATION_TIMEOUT_SECONDS=300
# Cada cuánto se revisa si hay conversaciones sin atender (en segundos).
AUTO_ESCALATION_CHECK_INTERVAL_SECONDS=60

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Documentos ---
DOCUMENTS_DIR=documents
VECTOR_DB_DIR=vector_db
# Tamaño máximo permitido por archivo (en MB)
MAX_FILE_SIZE_MB=25

# --- Seguridad ---
# El acceso al panel ahora es con cuentas reales (usuario + contraseña),
# administradas por el root -- ver scripts/create_root.py para crear la
# primera cuenta root.

# Orígenes permitidos por CORS, separados por coma (sin espacios extra).
# Incluye aquí la IP de red local si accedes al chat desde otro dispositivo,
# por ejemplo: http://localhost:8000,http://192.168.0.122:8000
ALLOWED_ORIGINS=http://localhost:8000

# Límite de peticiones a /api/chat y /api/chat/stream por IP, para evitar que
# alguien agote la cuota de Groq enviando peticiones repetidas.
CHAT_RATE_LIMIT_MAX=15
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Límite de intentos de /api/auth/login por IP, para frenar fuerza bruta.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
